# ══════════════════════════════════════════════════════════
# GLOW — environment
#
# Copy to `.env` for local development. In production these are set in
# the HOST's secret store (Render/Railway/Fly dashboard), never in a file
# in the repository. `.env` is gitignored; keep it that way.
# ══════════════════════════════════════════════════════════

# ── which data the site serves ─────────────────────────────
#   mock   — the catalogue from CONTENT.md, in memory. No credentials
#            needed. Every page shows a standing "sample data" banner.
#   moodle — the live platform. Requires MOODLE_URL below and the
#            web-services setup in docs/MOODLE-SETUP.md.
DATA_SOURCE=mock

# ── session encryption ─────────────────────────────────────
# 32 bytes, base64. Generate with:  npm run secret
# Rotating this signs everyone out — which is exactly what you want it
# to do the day you suspect it has leaked.
# REQUIRED in production. Left blank in dev, a throwaway key is generated.
SESSION_SECRET=

# How long a session lasts without activity. Sliding: active use extends it.
SESSION_TTL_MINUTES=480

# ── Moodle ─────────────────────────────────────────────────
# Site root. No trailing slash. Must be https:// in production — the
# learner's password is forwarded over this.
MOODLE_URL=https://glow.mata9.com

# The external service shortname created in docs/MOODLE-SETUP.md.
# `moodle_mobile_app` works without an admin creating anything, but grants
# far more than this site needs. Prefer a dedicated, narrower service.
MOODLE_SERVICE=glow_frontend

# Optional: category ids for the English / Resources pages. Without them
# the categories are looked up by name, which works but costs a call.
# MOODLE_CATEGORY_ENGLISH=
# MOODLE_CATEGORY_RESOURCES=

# ── this server ────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# Public URL of this site. REQUIRED in production: it is what cross-site
# request forgery checks compare against, and what marks cookies Secure.
PUBLIC_ORIGIN=

# Login throttling, per IP. Raise if learners share a connection (a school,
# a community centre) and legitimate users are being locked out.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW=15 minutes

# Set to false to switch sign-in off entirely and serve only the public
# marketing page. The lever to pull if credentials are ever suspected.
AUTH_ENABLED=true
