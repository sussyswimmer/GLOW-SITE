{
  "name": "glow-landing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "GLOW landing page - warm bilingual community, lantern-lit scroll story",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node server/index.js",
    "build": "node tools/build.mjs",
    "preview": "vite preview",
    "pages": "node tools/build-pages.mjs",
    "cms": "decap-server",
    "secret": "node tools/gen-secret.mjs",
    "check": "node --env-file-if-exists=.env tools/check-config.mjs",
    "catalogue": "node tools/crawl-public.mjs && node tools/pull-course-art.mjs && node tools/build-catalogue.mjs",
    "test": "node tools/smoke.mjs",
    "test:fixes": "node tools/verify-fixes.mjs",
    "test:app": "node tools/app-shots.mjs",
    "test:contrast": "node tools/app-contrast.mjs",
    "share": "node tools/build-share.mjs",
    "deploy:share": "npm run build && node tools/build-share.mjs && netlify deploy --prod --dir dist-share"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "decap-cms": "^3.15.1",
    "decap-server": "^3.10.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.10",
    "netlify-cli": "^27.1.1",
    "netlify-identity-widget": "^2.0.3",
    "playwright": "^1.62.1",
    "vite": "^7.1.7"
  }
}
